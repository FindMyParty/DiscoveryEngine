{
  "name": "discovery-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Discovery Engine service for FindMyParty — hexagonal architecture",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env --import tsx/esm src/main.ts",
    "dev:watch": "node --env-file=.env --watch --import tsx/esm src/main.ts",
    "set-up": "docker compose up -d --wait && npm start",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@sentry/node": "^9.14.0",
    "amqplib": "^0.10.7",
    "fastify": "^5.3.3",
    "kysely": "^0.27.4",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-loki": "^2.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.2"
  }
}
